# Credentials for the e2e suite (go test -tags e2e ./e2e/...).
# Copy to .env.local (gitignored) and fill in the secret. The suite reads these
# CAC_E2E_* vars; CI provides them as secrets instead.
#
# Values below target the postmance-dev test tenant (region eu).
CAC_E2E_ISSUER_URL=https://postmance-dev.eu.authz.cloudentity.io/postmance-dev/system
CAC_E2E_TENANT_ID=postmance-dev
CAC_E2E_CLIENT_ID=21ac20db6d0c4b8e8772f82af0a741c2
CAC_E2E_CLIENT_SECRET=
# CAC_E2E_INSECURE=true   # only for self-signed/local servers
